    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:deps": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@firebase/app": "0.16.7",
    "@firebase/auth": "1.13.11",
    "firebase-admin": "14.5.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "overrides": {
    "jose": "5.10.0"
  }
}
