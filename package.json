{
  "name": "lumen-quill",
  "version": "0.3.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Lumen Quill: a private, dated note archive (Next.js, Firebase Auth + Firestore, Vercel)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
