# =====================================================================
# lumine-archive: environment variable NAMES (no values here, ever).
# Production: Vercel -> Project -> Settings -> Environment Variables.
# Local: a file OUTSIDE the repo, used with `node --env-file=<file>` (never .env.local in this folder).
# =====================================================================

# ---- Firebase Admin (SERVER, SECRET) --------------------------------
# From a service-account key of the Firebase project (IAM). private_key on ONE line, newlines written as \n.
FIREBASE_PROJECT_ID=lumine-archive
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- Firebase Web (PUBLIC by design; baked in at build time) ---------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lumine-archive.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lumine-archive

# ---- App (REQUIRED in production) -----------------------------------
# Exact site origin(s), no trailing slash, comma separated. Used for the CSRF Origin check.
APP_ORIGIN=http://localhost:3000
# Random, >= 32 characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Random, >= 32 characters. Vercel Cron sends it as "Authorization: Bearer <value>". Empty = cron refused.
CRON_SECRET=

# ---- Bootstrap script only (scripts/bootstrap-admin.mjs) ----------------
ADMIN_EMAIL=
ADMIN_USERNAME=
